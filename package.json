{
  "name": "northstar",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": "24.20.0",
    "pnpm": "11.23.0"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build && pnpm test && pnpm python:check && pnpm secrets:check",
    "format": "prettier --write \"**/*.{css,js,cjs,mjs,ts,tsx,json,jsonc,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{css,js,cjs,mjs,ts,tsx,json,jsonc,yaml,yml}\"",
    "hooks:install": "simple-git-hooks",
    "lint": "eslint . --max-warnings 0 && turbo run lint",
    "prepare": "simple-git-hooks",
    "python:check": "pnpm python:format:check && pnpm python:lint && pnpm python:typecheck && pnpm python:test",
    "python:format:check": "uv run --directory apps/big-backend ruff format --check .",
    "python:lint": "uv run --directory apps/big-backend ruff check .",
    "python:test": "uv run --directory apps/big-backend pytest",
    "python:typecheck": "uv run --directory apps/big-backend mypy",
    "secrets:check": "secretlint **/*",
    "test": "vitest run && turbo run test",
    "typecheck": "tsc --noEmit && turbo run typecheck"
  },
  "simple-git-hooks": {
    "pre-commit": "corepack pnpm exec lint-staged",
    "pre-push": "corepack pnpm check"
  },
  "lint-staged": {
    "*": "secretlint",
    "*.py": [
      "uv run --directory apps/big-backend ruff format",
      "uv run --directory apps/big-backend ruff check --fix"
    ],
    "*.{js,cjs,mjs,ts,tsx}": "eslint --max-warnings 0",
    "*.{css,js,cjs,mjs,ts,tsx,json,jsonc,yaml,yml}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.4",
    "@types/node": "26.3.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "secretlint": "13.0.4",
    "simple-git-hooks": "2.13.1",
    "turbo": "2.10.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
